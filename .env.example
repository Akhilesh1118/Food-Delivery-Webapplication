# Server Configuration
PORT=3000

# MongoDB URI (Optional: if not set, in-memory store is used seamlessly)
MONGODB_URI=

# JWT Secret for Authentication
JWT_SECRET=super_secret_food_del_jwt_key

# Sole administrator credentials (server-side only)
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_NAME=Restaurant Administrator

# Stripe Secret Key (Optional: if not set, simulated instant checkout is enabled)
STRIPE_SECRET_KEY=

# Cloudinary Credentials (Optional: if not set, local uploads are used)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Integration Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Gemini API (Server-side)
GEMINI_API_KEY=
